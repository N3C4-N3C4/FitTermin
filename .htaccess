Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Zabrani direktan pristup internim folderima i fajlovima
    RewriteRule ^(app|config|database)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^README\.md$ - [F,L]

    # Sve što nije postojeći fajl (CSS, JS, slike) ide na front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
